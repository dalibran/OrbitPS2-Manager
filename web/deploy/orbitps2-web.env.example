# Paths must exist, and the service account needs write access.
ORBIT_LIBRARY_ROOT=/srv/ps2
ORBIT_INBOX=/srv/ps2-inbox
ORBIT_DATA_DIR=/var/lib/orbitps2-web
# Listen on LAN interfaces. Public remote IPs are rejected by the application.
ORBIT_HOST=0.0.0.0
PORT=3000
# Pi 3B+ baseline. Can be increased on larger Pis after measurement.
ORBIT_WORKERS=1
ORBIT_MAX_UPLOAD_GIB=16
# Optional comma-separated additional local hostnames (no scheme or port).
ORBIT_ALLOWED_HOSTS=orbitps2.local
# Optional; obtain a personal API key from SteamGridDB. Keep it server-side.
# STEAMGRIDDB_API_KEY=
